  {
    "id": "gen_force_peak_refresh_rate",
    "name": "Force Peak High Refresh Rate",
    "description": "Sets min_refresh_rate equal to peak_refresh_rate (120Hz/144Hz) preventing the screen from dropping to 60Hz during scrolling.",
    "category": "display",
    "risk": "Safe",
    "targetOem": "generic",
    "minSdk": 29,
    "applyCommands": [
      "settings put system peak_refresh_rate 120.0",
      "settings put system min_refresh_rate 120.0"
    ],
    "revertCommands": [
      "settings delete system min_refresh_rate",
      "settings put system peak_refresh_rate 120.0"
    ],
    "verifyCommand": "settings get system min_refresh_rate",
    "expectedValue": "120.0",
    "tags": ["display", "fluidity", "120hz"]
  },
  {
    "id": "gen_private_dns_cloudflare",
    "name": "Cloudflare Encrypted DoH DNS",
    "description": "Forces 1.1.1.1 DNS over TLS for encrypted lookups, lower latency, and ISP tracking prevention.",
    "category": "privacy",
    "risk": "Safe",
    "targetOem": "generic",
    "minSdk": 28,
    "applyCommands": [
      "settings put global private_dns_mode hostname",
      "settings put global private_dns_specifier 1dot1dot1dot1.cloudflare-dns.com"
    ],
    "revertCommands": [
      "settings put global private_dns_mode opportunistic",
      "settings delete global private_dns_specifier"
    ],
    "verifyCommand": "settings get global private_dns_specifier",
    "expectedValue": "1dot1dot1dot1.cloudflare-dns.com",
    "tags": ["privacy", "dns", "security", "cloudflare"]
  },

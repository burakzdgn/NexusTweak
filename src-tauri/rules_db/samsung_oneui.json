[
  {
    "id": "samsung_bixby_voice_debloat",
    "name": "Bixby Voice & Agent Debloat",
    "description": "Disables Samsung Bixby background listener, wake word detector, and dictation services to free up RAM.",
    "category": "debloat",
    "risk": "Safe",
    "targetOem": "samsung",
    "minSdk": 28,
    "packages": [
      "com.samsung.android.bixby.agent",
      "com.samsung.android.bixby.voiceinput",
      "com.samsung.android.bixby.wakeup",
      "com.samsung.android.app.spage"
    ],
    "applyCommands": [
      "pm disable-user --user 0 com.samsung.android.bixby.agent",
      "pm disable-user --user 0 com.samsung.android.bixby.voiceinput",
      "pm disable-user --user 0 com.samsung.android.bixby.wakeup",
      "pm disable-user --user 0 com.samsung.android.app.spage"
    ],
    "revertCommands": [
      "pm enable com.samsung.android.bixby.agent",
      "pm enable com.samsung.android.bixby.voiceinput",
      "pm enable com.samsung.android.bixby.wakeup",
      "pm enable com.samsung.android.app.spage"
    ],
    "tags": ["samsung", "bixby", "battery", "debloat"]
  },
